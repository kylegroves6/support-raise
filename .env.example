# Environment variable template — copy to the appropriate file for your environment.
#
# LOCAL  → values are auto-exported by `supabase start`; no .env file needed for local dev
# STAGING → copy this to .env.staging.local and fill in your staging Supabase project values
# PRODUCTION → set these in Vercel environment variables; never put prod values in a .env file

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional: Sentry error tracking DSN (leave empty to disable)
VITE_SENTRY_DSN=
